# From @BotFather
TELEGRAM_TOKEN=your_token

# Your chat ID (run /mychatid)
CHAT_ID=your_chat_id

# Africa timezone
TIMEZONE=Africa/Lagos

# Betting bankroll USD
BANKROLL=1000

# Free from football-data.org (required)
FOOTBALL_DATA_KEY=your_key_here

# Free from RapidAPI — API-Football (optional, improves H2H)
API_FOOTBALL_KEY=your_key_here

# Minimum draw odds to consider (below this = too short)
MIN_ODDS=2.80
